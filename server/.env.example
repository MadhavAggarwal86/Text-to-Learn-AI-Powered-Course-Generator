# Copy to server/.env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=5050

# Comma-separated list of allowed frontend origins (add your Vercel URL in production)
CLIENT_ORIGINS=http://localhost:5173

# MongoDB Atlas connection string, including the database name:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/text-to-learn?retryWrites=true&w=majority
# (optional until the course API lands in Phase 3)
MONGO_URI=

# Google Gemini (https://aistudio.google.com/apikey). Without a key, AI routes answer 503.
GEMINI_API_KEY=
# Optional overrides. The fallback is tried when the main model times out or is overloaded;
# leave it empty to disable. Timeout is per call, in milliseconds.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# GEMINI_TIMEOUT_MS=45000

# Added in later phases
# AUTH0_ISSUER=https://your-tenant.auth0.com/
# AUTH0_AUDIENCE=https://text-to-learn-api
# YOUTUBE_API_KEY=
