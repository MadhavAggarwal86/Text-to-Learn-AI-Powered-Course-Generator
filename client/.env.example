# Copy to client/.env and fill in. Every VITE_ variable is PUBLIC (bundled into the browser),
# so never put secret API keys here.

# Backend base URL. Leave empty in local dev: Vite proxies /api to http://localhost:5050.
# In production (Vercel) set it to your Render URL, e.g. https://text-to-learn-api.onrender.com
VITE_API_URL=

# Added in Phase 6 (Auth0 domain and client ID are public by design)
# VITE_AUTH0_DOMAIN=your-tenant.auth0.com
# VITE_AUTH0_CLIENT_ID=
# VITE_AUTH0_AUDIENCE=https://text-to-learn-api
