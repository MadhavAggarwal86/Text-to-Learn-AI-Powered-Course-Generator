# Copy to client/.env and fill in. Every VITE_ variable is PUBLIC (bundled into the browser),
# so never put secret API keys here.

# Backend base URL. Leave empty in local dev: Vite proxies /api to http://localhost:5050.
# In production (Vercel) set it to your Render URL, e.g. https://text-to-learn-api.onrender.com
VITE_API_URL=

# Auth0 Single Page Application settings (public by design). Leave all three empty to run
# locally without login as a single dev user (the server must also have no Auth0 settings).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# Must match the server's AUTH0_AUDIENCE (the Auth0 API Identifier).
VITE_AUTH0_AUDIENCE=
